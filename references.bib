% ===== 参考文献示例 =====
% 使用 BibLaTeX + Biber 管理，格式遵循 GB/T 7714-2015
% 在正文中使用 \cite{key} 引用
% ==========================

% 示例：专著 [M]
@book{example_book,
	author={作者姓名},
	title={书籍名称},
	publisher={出版社},
	address={出版地},
	year={2024}
}

% 示例：期刊文章 [J]
@article{example_article,
	author={张三 and 李四},
	title={论文标题},
	journal={期刊名称},
	volume={10},
	number={2},
	pages={100--110},
	year={2024}
}

% 示例：学位论文 [D]
@mastersthesis{example_thesis,
	author={王五},
	title={学位论文标题},
	school={湖南工商大学},
	year={2024}
}

% 示例：会议论文 [C]
@inproceedings{example_conference,
	author={Smith, John and Doe, Jane},
	title={Conference Paper Title},
	booktitle={Proceedings of the International Conference},
	pages={1--10},
	year={2024}
}

% 示例：报刊文章 [N]
@article{example_newspaper,
	author={董计营},
	title={国有经济——经济发展的控制性力量},
	journal={经济时报},
	year={2000},
	note={2000-11-20(5)}
}

% 示例：专利 [P]
@misc{example_patent,
	author={姜锡洲},
	title={一种温热外敷药制备方案},
	year={1983},
	note={中国专利：881056078，1983-08-12}
}

% 示例：国家标准 [S]
@misc{example_standard,
	author={{GB/T 16159—1996}},
	title={汉语拼音正词法基本规则},
	publisher={中国标准出版社},
	address={北京},
	year={1996}
}

% 示例：在线资源 [EB/OL]
@misc{example_online,
	author={作者},
	title={网页标题},
	year={2024},
	note={\url{https://example.com}}
}

% 示例：外文期刊 [J]（学校要求应有外文参考文献）
@article{example_english,
	author={Smith, John and Doe, Jane},
	title={A Survey of Machine Learning Methods},
	journal={IEEE Transactions on Pattern Analysis and Machine Intelligence},
	volume={45},
	number={3},
	pages={100--120},
	year={2024}
}
